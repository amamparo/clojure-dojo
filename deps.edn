{:paths ["src" "resources"]
 :deps {org.clojure/clojure {:mvn/version "1.12.0"}}
 :aliases
 {;; Test path + deps only. No :main-opts, so this alias is safe to
  ;; select for an editor REPL jack-in (Calva).
  :test {:extra-paths ["test"]
         :extra-deps {lambdaisland/kaocha {:mvn/version "1.91.1392"}}}
  ;; The Kaocha runner entry point. Combine with :test on the CLI:
  ;; `clj -M:test:kaocha`. Keep :main-opts OUT of :test.
  :kaocha {:main-opts ["-m" "kaocha.runner"]}
  :cljfmt {:deps {dev.weavejester/cljfmt {:mvn/version "0.16.4"}}
           :ns-default cljfmt.tool}}}
