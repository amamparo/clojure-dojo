#kaocha/v1
{:tests [{:id :unit
          :test-paths ["test"]}]
 ;; documentation reporter: prints every test, nested under its
 ;; namespace, green ✓ on pass and red ✗ on fail/error.
 :reporter kaocha.report/documentation
 :color? true
 ;; deterministic order — this is a learning repo, not a flake hunt.
 :randomize? false
 :bindings
 {;; On a thrown exception, show the gist — not 60 lines of framework
  ;; frames. Elide Kaocha's / tooling's own frames so only the
  ;; originating line and your katas.* frames remain...
  kaocha.stacktrace/*stacktrace-filters*
  ["java.lang." "clojure.test$" "clojure.lang." "clojure.core"
   "clojure.main" "kaocha." "nrepl." "lambdaisland." "cider."]
  ;; ...and hard-cap the depth as a backstop.
  clojure.test/*stack-trace-depth* 5}}
