;; The `user` namespace exists only as a REPL bootstrap (see dev/user.clj).
;; Its private helpers don't get called by anything compile-time-visible,
;; so we suppress the unused-var linters here.
{:config-in-ns
 {user {:linters {:unused-private-var {:level :off}
                  :clojure-lsp/unused-public-var {:level :off}}}}}
