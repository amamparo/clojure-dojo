;; clj-kondo backs `just lint` and editor analysis. The katas under src
;; ship as `;; TODO` stubs, so unused params in those namespaces are by
;; design (a fresh clone is red on purpose). The test namespaces are
;; linted in full, except that the kata 16 test binds names on purpose
;; (`[a nil] :unreached`, operands inside an `infix` form). `:lint-as`
;; teaches kondo the custom `when-let*` binding macro. `infix` takes a
;; parenthesised arithmetic form as DATA (e.g. `(1 + 2)`), so it is linted
;; as `quote` — otherwise kondo reads `1` in call position as "a number
;; is not a function". These exemptions are deliberate; do not "fix" them
;; back.
{:lint-as   {katas.kata-16-macros/when-let* clojure.core/let
             katas.kata-16-macros/infix     clojure.core/quote}
 :ns-groups [{:pattern "katas\\.(?!.*-test$).*" :name katas}]
 :config-in-ns
 {katas {:linters {:unused-binding {:level :off}}}
  katas.kata-16-macros-test {:linters {:unused-binding {:level :off}}}}}
